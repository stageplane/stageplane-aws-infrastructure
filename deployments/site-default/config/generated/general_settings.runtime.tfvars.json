{
  "argocd_admin_password": "",
  "argocd_admin_password_sops_file": "deployments/site-default/config/argocd/.secret.enc.yaml",
  "argocd_base_kustomize": "github.com/mycompany/aws-gitops-infrastructure//environments/dev/deployments/argocd?ref=main",
  "argocd_bootstrap_enabled": false,
  "argocd_bootstrap_kustomize": "github.com/mycompany/aws-gitops-infrastructure//environments/dev/bootstrap/argocd?ref=main",
  "argocd_chart_version": "7.7.16",
  "argocd_enabled": true,
  "argocd_namespace": "argocd",
  "availability_zones": [
    "us-west-2a",
    "us-west-2b",
    "us-west-2c"
  ],
  "aws_profile": "default",
  "aws_region": "us-west-2",
  "backend": {
    "config": {
      "bucket": "example-platform-dev-us-west-2-tfstate",
      "dynamodb_table": "example-platform-dev-us-west-2-tf-lock",
      "region": "us-west-2"
    },
    "mode": "managed",
    "type": "s3"
  },
  "cloud": "aws",
  "cluster_name": "example-platform-dev-us-west-2-eks",
  "cluster_version": "1.33",
  "company_name": "example",
  "compute": {
    "karpenter": {
      "chart_version": "1.8.1",
      "enabled": true,
      "namespace": "karpenter",
      "node_pools": [
        {
          "capacity": {
            "type": "spot"
          },
          "instance": {
            "types": [
              "p5.48xlarge",
              "p4d.24xlarge"
            ]
          },
          "limits": {
            "cpu": "1000"
          },
          "name": "gpu-spot",
          "role": "gpu"
        }
      ]
    },
    "node_groups": [
      {
        "capacity": {
          "backend": "managed_node_group",
          "type": "on_demand"
        },
        "instance": {
          "types": [
            "m7i.large"
          ]
        },
        "labels": {
          "stageplane.io/capacity": "on_demand",
          "stageplane.io/role": "system"
        },
        "name": "system",
        "role": "system",
        "scaling": {
          "desired": 3,
          "max": 6,
          "min": 3
        }
      },
      {
        "capacity": {
          "backend": "fargate_profile",
          "type": "fargate"
        },
        "fargate": {
          "namespaces": [
            "kube-system",
            "default"
          ]
        },
        "labels": {
          "stageplane.io/capacity": "fargate",
          "stageplane.io/role": "system"
        },
        "name": "serverless-system",
        "role": "system"
      },
      {
        "capacity": {
          "backend": "managed_node_group",
          "type": "on_demand"
        },
        "instance": {
          "types": [
            "p5.48xlarge",
            "p4d.24xlarge"
          ]
        },
        "labels": {
          "stageplane.io/capacity": "mixed",
          "stageplane.io/role": "gpu"
        },
        "name": "gpu-ondemand",
        "role": "gpu",
        "scaling": {
          "desired": 1,
          "max": 8,
          "min": 1
        },
        "taints": [
          {
            "effect": "NO_SCHEDULE",
            "key": "workload",
            "value": "gpu"
          }
        ]
      },
      {
        "capacity": {
          "backend": "managed_node_group",
          "spot": {
            "allocation_strategy": "price-capacity-optimized",
            "enabled": true,
            "fallback_to_ondemand": true,
            "max_price": "12.50"
          },
          "type": "spot"
        },
        "instance": {
          "types": [
            "p5.48xlarge",
            "p4d.24xlarge"
          ]
        },
        "labels": {
          "stageplane.io/capacity": "mixed",
          "stageplane.io/role": "gpu"
        },
        "name": "gpu-spot",
        "role": "gpu",
        "scaling": {
          "desired": 0,
          "max": 8,
          "min": 0
        },
        "taints": [
          {
            "effect": "NO_SCHEDULE",
            "key": "workload",
            "value": "gpu"
          }
        ]
      }
    ]
  },
  "environment": "dev",
  "hosted_zone_name": "dev.example.internal",
  "iac_runtime": "terraform",
  "platform_name": "platform",
  "private_subnet_cidrs": [
    "10.0.0.0/20",
    "10.0.16.0/20",
    "10.0.32.0/20"
  ],
  "public_subnet_cidrs": [
    "10.0.128.0/24",
    "10.0.129.0/24",
    "10.0.130.0/24"
  ],
  "vpc_cidr": "10.0.0.0/16"
}
